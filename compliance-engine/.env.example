# Environment Configuration
# Copy this file to .env and update values as needed

# Application
APP_NAME=compliance-engine
APP_ENV=development
DEBUG=false
PORT=8000
MAX_UPLOAD_BYTES=5242880
AUTO_CREATE_SCHEMA=true

# Database
# For local development: sqlite:///./local.db
# For Render Postgres: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./local.db

# CORS - Comma-separated list of allowed origins
# Add your Vercel frontend domain here
CORS_ORIGINS=http://localhost:3000,https://YOUR-VERCEL-DOMAIN.vercel.app

# File Storage
FILE_STORAGE_PATH=./storage/files
FILE_STORAGE_BACKEND=local

# Logging
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
API_KEY_BINDINGS=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Administrator dashboard
# Generate password hashes with:
# python -m app.admin.security
ADMIN_USERS=
# Example:
# ADMIN_USERS={"admin@example.com":{"password_hash":"pbkdf2_sha256$...","role":"admin"},"ops@example.com":{"password_hash":"pbkdf2_sha256$...","role":"operator"}}
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=false

# Optional local fallback for a single admin user. Use ADMIN_USERS in production.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Alert delivery
# Use an HTTPS webhook from Slack, Teams, PagerDuty, Make, Zapier, or another incident tool.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
ALERT_DEDUP_WINDOW_SECONDS=900
ALERT_SEVERITIES=critical,warning
