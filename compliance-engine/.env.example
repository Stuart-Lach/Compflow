# Environment Configuration
# Copy this file to .env and update values as needed

# Application
APP_NAME=compliance-engine
APP_ENV=development
DEBUG=false
PORT=8000
MAX_UPLOAD_BYTES=5242880
AUTO_CREATE_SCHEMA=true

# Database
# For local development: sqlite:///./local.db
# For Render Postgres: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///./local.db

# CORS - Comma-separated list of allowed origins
# Add your Vercel frontend domain here
CORS_ORIGINS=http://localhost:3000,https://YOUR-VERCEL-DOMAIN.vercel.app

# File Storage
FILE_STORAGE_PATH=./storage/files
FILE_STORAGE_BACKEND=local

# Logging
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
API_KEY_BINDINGS=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
